{
  "name": "simple-fullstack-app",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "^npm@10.9.0",
  "scripts": {
    "dev": "turbo run build && npm run start",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "start": "npm run start --workspace apps/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.14.0",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  }
}
