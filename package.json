{
  "name": "simple-fullstack-app",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace packages/server",
    "clean": "rm -rf node_modules && npm run clean --workspaces",
    "dev": "npm run build --workspaces && npm run start",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.14.0",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  }
}
